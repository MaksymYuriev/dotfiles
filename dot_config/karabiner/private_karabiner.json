{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "F18 -> English, F19 -> Ukrainian (idempotent input source keys, sent by Voyager)",
                        "manipulators": [
                            {
                                "from": { "key_code": "f18" },
                                "to": [{ "select_input_source": { "language": "^en$" } }],
                                "type": "basic"
                            },
                            {
                                "from": { "key_code": "f19" },
                                "to": [{ "select_input_source": { "language": "^uk$" } }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Built-in keyboard: left Cmd tap -> English, right Cmd tap -> Ukrainian",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "identifiers": [{ "is_built_in_keyboard": true }],
                                        "type": "device_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "left_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_command" }],
                                "to_if_alone": [{ "select_input_source": { "language": "^en$" } }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "identifiers": [{ "is_built_in_keyboard": true }],
                                        "type": "device_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "right_command" }],
                                "to_if_alone": [{ "select_input_source": { "language": "^uk$" } }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Built-in keyboard: Caps Lock -> Meh (hold) / Escape (tap)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "identifiers": [{ "is_built_in_keyboard": true }],
                                        "type": "device_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_control", "left_option"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}