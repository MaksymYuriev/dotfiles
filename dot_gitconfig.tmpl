[user]
    name = {{ .name }}
    email = {{ .email }}
    signingkey = {{ .signingkey }}
[init]
    defaultBranch = main
[pull]
    rebase = true
[rebase]
    autoStash = true
[push]
    autoSetupRemote = true
[fetch]
    prune = true
[rerere]
    enabled = true
[merge]
    conflictStyle = zdiff3
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
[gpg]
    format = ssh
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
    gpgsign = true
