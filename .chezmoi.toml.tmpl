{{- $name := promptStringOnce . "name" "Git name" -}}
{{- $email := promptStringOnce . "email" "Git email (linked to GitHub)" -}}
{{- $signingkey := promptStringOnce . "signingkey" "SSH public key from 1Password (ssh-ed25519 ...)" -}}
[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    signingkey = {{ $signingkey | quote }}
